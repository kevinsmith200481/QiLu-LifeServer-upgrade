# ==================== 模型服务与生成参数 ====================
# 模型服务访问凭证和 OpenAI 兼容接口地址，供 Python Agent 和 Java AI Provider 共用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://replace-with-your-provider-host/v1
# 通用模型用于回答生成、工单摘要和分类；原生工具模型用于低延迟的两轮 Function Calling。
AI_MODEL=replace-with-your-provider-model
AI_NATIVE_MODEL=replace-with-your-provider-tool-model
# 控制模型生成随机性、单次调用超时和 SDK 内部重试次数。
AI_TEMPERATURE=0.2
AI_MODEL_TIMEOUT_SECONDS=8
AI_MODEL_MAX_RETRIES=0
# 限制原生工具模型的推理强度和单次输出长度，确保两轮调用处于整体超时预算内。
AI_NATIVE_REASONING_EFFORT=none
AI_NATIVE_MAX_COMPLETION_TOKENS=256

# ==================== 语义意图分类 ====================
# semantic 使用结构化分类结果；semantic_shadow 只记录差异；严重误路由时可回退 keyword。
AI_INTENT_ROUTER_MODE=semantic
# 默认继承 AI_NATIVE_MODEL；单次调用超时 15 秒，最多重试 2 次且不使用推理预算。
AI_INTENT_MODEL=
AI_INTENT_OUTPUT_MODE=json_object
AI_INTENT_TIMEOUT_SECONDS=15
AI_INTENT_MAX_RETRIES=2
AI_INTENT_REASONING_EFFORT=none

# ==================== Agent 运行与工具规划 ====================
# Agent 实例标识用于运行状态和多实例知识同步识别。
AI_AGENT_INSTANCE_ID=agent-local-1
# 当前主线使用 LangGraph 编排；意图由语义模型判断，hybrid 工具规划优先使用原生 Function Calling，模型或兼容性失败时明确进入 rule_fallback。
AGENT_ORCHESTRATOR=langgraph
AI_PLANNER_MODE=hybrid

# ==================== Java 主服务业务工具 ====================
# Agent 通过主服务内部接口执行只读业务查询，内部 Token 必须与主服务配置一致。
AI_TOOL_BASE_URL=http://localhost:8081
AI_TOOL_TOKEN=replace-with-shared-internal-token
# 单次工具调用的总超时，包含 HTTP 连接、读取和结果解析。
AI_TOOL_TIMEOUT_SECONDS=3

# ==================== 知识库与向量检索 ====================
# Embedding 服务、模型、维度和算法修订必须互相匹配；部署修订不得包含地址或密钥。
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_ALGORITHM_REVISION=openai-v1
AI_EMBEDDING_DEPLOYMENT_REVISION=replace-with-non-sensitive-deployment-revision
RAG_VECTOR_QUERY_REWRITE=true
RAG_VECTOR_QUERY_PREFIX=
# 生产模式要求先同步 ai_knowledge，不允许使用内置样例知识直接回答。
CAMPUS_KB_MODE=production
CAMPUS_REQUIRE_AI_KNOWLEDGE_SYNC=true
CAMPUS_ALLOW_SAMPLE_KB=false
# 本地知识目录和 FAISS 持久化目录；默认启动时加载已有索引而不强制重建。
CAMPUS_KB_DIR=knowledge
CAMPUS_VECTOR_INDEX_DIR=data/faiss
CAMPUS_VECTOR_REBUILD_ON_START=false
# 正常路径使用 Milvus + BM25；只有 Milvus 不可用时才切换为 FAISS + BM25。
MILVUS_ENABLED=true
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=qilu_ai_knowledge
MILVUS_CONNECT_TIMEOUT_SECONDS=2
# 生产激活必须同时具备 BM25 与 Milvus；FAISS 是 Milvus 故障时的可选本地备份。
RAG_REQUIRED_BACKENDS=bm25,milvus
# active alias 切换后保留最近两个物理版本，超出部分至少等待 30 秒再清理。
RAG_MILVUS_RETAINED_COLLECTIONS=2
RAG_MILVUS_CLEANUP_GRACE_SECONDS=30
RAG_TOP_K=3
RAG_VECTOR_CANDIDATE_K=12
RAG_LEXICAL_CANDIDATE_K=12
RAG_RRF_K=60
RAG_MAX_CHUNKS_PER_KNOWLEDGE=2
RAG_CONTEXT_MAX_CHARACTERS=6000
RAG_MIN_MILVUS_SCORE=0.2
RAG_MIN_FAISS_SCORE=0.2
RAG_MIN_BM25_SCORE=0.2
# FAISS 仅作为本地/故障备份；小规模索引使用单线程可避免 OpenMP 调度放大尾延迟。
RAG_FAISS_SEARCH_THREADS=1
# 三个检索后端统一使用同一正文切分参数；修改分隔算法时必须提升算法修订。
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=40
RAG_CHUNK_UNIT=character
RAG_CHUNK_ALGORITHM=recursive-v1
# BM25 算法、中文分词修订和字段权重共同进入 lexicalFingerprint。
RAG_LEXICAL_IMPLEMENTATION=okapi-bm25-v1
RAG_TOKENIZER_REVISION=alnum-cjk-2-4-v1
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
RAG_BM25_TITLE_WEIGHT=2.0
RAG_BM25_CATEGORY_WEIGHT=1.5
RAG_BM25_KEYWORD_WEIGHT=2.0

# ==================== LangGraph 持久化恢复 ====================
# MySQL ai_session/ai_message 仍是业务事实源，SQLite 只保存脱敏后的图恢复状态。
AI_CHECKPOINT_ENABLED=true
AI_CHECKPOINT_PATH=data/checkpoints/langgraph.sqlite3
# 配置线程状态有效期、单线程最大保留版本数、清理间隔和状态结构版本。
AI_CHECKPOINT_TTL_SECONDS=604800
AI_CHECKPOINT_MAX_RETAINED=40
AI_CHECKPOINT_CLEANUP_INTERVAL_SECONDS=300
AI_CHECKPOINT_SCHEMA_VERSION=3
# Provider 调用 Agent 内部 Checkpoint 删除和 Memory 摘要接口时使用，必须与 Provider 配置一致。
AI_CHECKPOINT_INTERNAL_TOKEN=replace-with-provider-agent-internal-token

# ==================== OpenTelemetry 可观测性 ====================
# 默认不导出 Span；启用后通过 OTLP Collector 汇报 Agent 链路。
AI_OTEL_ENABLED=false
OTEL_SERVICE_NAME=qilu-ai-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
