# QiLu LifeServer local runtime template.
# Copy values into your shell environment or a local .env loader; do not commit real secrets.

QILU_MYSQL_URL=jdbc:mysql://localhost:3306/qilu?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
QILU_MYSQL_USERNAME=root
QILU_MYSQL_PASSWORD=change-me

QILU_REDIS_HOST=127.0.0.1
QILU_REDIS_PORT=6379
QILU_REDIS_PASSWORD=change-me
QILU_REDIS_DATABASE=0
QILU_REDIS_CONNECT_TIMEOUT=3s
QILU_REDIS_TIMEOUT=3s
# Retained source endpoint used only by the split-brain startup guard.
QILU_REDIS_SOURCE_HOST=
QILU_REDIS_SOURCE_PORT=6379

CAMPUS_SMS_MODE=logging
CAMPUS_SMS_ENDPOINT=
CAMPUS_SMS_AUTH_HEADER_NAME=
CAMPUS_SMS_AUTH_HEADER_VALUE=
CAMPUS_SMS_ACCESS_KEY=
CAMPUS_SMS_SECRET_KEY=
CAMPUS_SMS_TEMPLATE_ID=
CAMPUS_SMS_SIGN_NAME=
CAMPUS_SMS_SUCCESS_KEYWORD=
CAMPUS_SMS_CONNECT_TIMEOUT_MILLIS=3000
CAMPUS_SMS_READ_TIMEOUT_MILLIS=5000

# Shared by qilu-ai-service and qilu-ai-agent for checkpoint cleanup and Memory summary calls.
# Use the same non-empty value in qilu-ai-agent/.env.
AI_CHECKPOINT_INTERNAL_TOKEN=replace-with-provider-agent-internal-token

# ==================== AI 会话 Memory v2 ====================
AI_MEMORY_MODE=legacy
AI_MEMORY_SCHEMA_VERSION=2
AI_MEMORY_RECENT_TURNS=8
AI_MEMORY_REBUILD_TURNS=100
AI_MEMORY_MAX_INPUT_TOKENS=3000
AI_MEMORY_MAX_TURN_CHARS=1200
AI_MEMORY_SUMMARY_MAX_CHARS=1000
AI_MEMORY_SUMMARY_TRIGGER_TURNS=4
AI_MEMORY_SUMMARY_TRIGGER_TOKENS=1800
# 默认关闭；开启后仅在有界后台线程调用 Agent 内部摘要端点。
AI_MEMORY_SUMMARIZER_ENABLED=false
AI_MEMORY_SUMMARIZER_TIMEOUT_SECONDS=8
AI_MEMORY_SUMMARIZER_MAX_RETRIES=1
AI_MEMORY_SUMMARIZER_THREADS=1
AI_MEMORY_SUMMARIZER_QUEUE_CAPACITY=32
